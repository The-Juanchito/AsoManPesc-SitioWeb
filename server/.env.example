# Copia este archivo como ".env" y ajusta los valores:
#   Windows (PowerShell):  Copy-Item .env.example .env

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=asomanpesc_admin
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=asomanpesc_db

# --- Servidor ---
PORT=4000
# Dirección desde la que se abre la página (Vite)
CORS_ORIGIN=http://localhost:3000

# Clave secreta para firmar las sesiones. Pon una frase larga y aleatoria.
JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta

# --- Administrador predeterminado (se crea con: npm run setup) ---
# Es una cuenta REAL guardada en MySQL. Cámbialos por tus datos.
ADMIN_NAME=Administrador AsoManPesc
ADMIN_EMAIL=admin@tudominio.com
ADMIN_CEDULA=1234567890
# Mínimo 8 caracteres. Si lleva el símbolo # ponla entre comillas: "Clave#2026". Si lo dejas vacío, setup genera una al azar y la muestra una sola vez.
ADMIN_PASSWORD=
ADMIN_PHONE=

# --- En Railway no uses este archivo: las variables se escriben en su panel (ver GUIA_RAILWAY.md).
# CORS_ORIGIN admite varias direcciones separadas por coma.
