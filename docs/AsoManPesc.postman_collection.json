{
  "info": {
    "name": "AsoManPesc API",
    "description": "API de AsoManPesc (Express + MySQL en Railway).\n\n1) Ejecuta *Auth → Login* con tu correo y contraseña: el token se guarda solo.\n2) Las demás peticiones usan ese token automáticamente (Bearer).\n\nLos asociados ven solo lo suyo; los clientes solo sus pedidos; el administrador ve todo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://asomanpesc-sitioweb-production.up.railway.app/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "danilopuerta16@gmail.com"
    },
    {
      "key": "password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Estado",
      "item": [
        {
          "name": "Health (público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Comprueba que el servidor y MySQL responden."
          }
        },
        {
          "name": "Estado de la base (admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/estado",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estado"
              ]
            },
            "description": "Conteo de filas por tabla. Solo administrador."
          }
        },
        {
          "name": "Precio de referencia",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/precio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "precio"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Devuelve { token, user }. El token se guarda en la variable de colección `token`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  console.log('Token guardado para', data.user.email, '(' + data.user.role + ')');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
