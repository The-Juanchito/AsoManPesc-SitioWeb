            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carla Ruiz\",\n  \"phone\": \"3009998888\",\n  \"role\": \"cliente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cambia :id por el id del usuario. Para restablecer contraseña envía `password`."
